<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ratt.habit-assistant</string>

    <!-- Update both paths below to your actual clone location before loading. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/habit-assistant/.venv/bin/python</string>
        <string>-m</string>
        <string>habit_assistant.main</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/habit-assistant</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart on crash, but not if the process exits cleanly (exit 0). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/habit-assistant/data/habit-assistant.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/habit-assistant/data/habit-assistant.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
